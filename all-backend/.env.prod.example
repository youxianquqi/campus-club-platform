# =============================================================================
# 生产环境变量配置示例
# 复制为 .env.prod 并填写实际值，勿将含真实密钥的文件提交仓库
# =============================================================================

# ---------- 运行配置 ----------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---------- MySQL 数据库 ----------
MYSQL_HOST=39.98.80.251
MYSQL_PORT=3306
MYSQL_DATABASE=club_home
MYSQL_USER=root_sea
MYSQL_PASSWORD=123456
MYSQL_SSL=true

# MySQL 连接池（可选，默认已在 application-prod.yml 中配置）
# MYSQL_POOL_MAX=20
# MYSQL_POOL_MIN=5



# Redis 连接池（可选）
# REDIS_POOL_MAX_ACTIVE=32
# REDIS_POOL_MAX_IDLE=16
# REDIS_POOL_MIN_IDLE=4

# ---------- JWT 配置 ----------
# 必须设置，密钥长度建议 >= 32 字符
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRE_MS=86400000

# ---------- 文件上传 ----------
# 生产环境使用绝对路径，并确保目录存在且有写入权限
FILE_UPLOAD_PATH=/data/endtiem/uploads/
# FILE_MAX_SIZE=10MB

# ---------- AI（DeepSeek） ----------
# 必须设置有效的 API Key
AI_API_KEY=your_deepseek_api_key_here
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_MODEL=deepseek-chat

# ---------- 日志 ----------
# LOG_PATH=/var/log/endtiem
